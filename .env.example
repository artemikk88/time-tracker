# Скопируйте этот файл в .env для локального запуска: cp .env.example .env

# Локальная база SQLite (создаётся командой `bun run db:push`).
# Путь считается от файла prisma/schema.prisma, поэтому "../db".
DATABASE_URL="file:../db/custom.db"

# Токен бота из @BotFather. Пусто (или отсутствует) = приложение работает в
# демо-режиме в обычном браузере, сессия подменяется тестовым пользователем.
BOT_TOKEN=

# Telegram id администраторов (начальника) через запятую, например: 123456789,987654321.
# Если пусто — админом автоматически становится ПЕРВЫЙ вошедший сотрудник
# (тот, кто настраивал бота и открыл приложение первым).
ADMIN_TELEGRAM_IDS=

# На Vercel эти же переменные задаются в Settings → Environment Variables,
# а DATABASE_URL там — строка подключения от Neon (PostgreSQL), см. README.
